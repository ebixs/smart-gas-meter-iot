{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ebixs/smart-gas-meter-iot/blob/main/schemas/telemetry.schema.json",
  "title": "Smart Gas Meter IoT Synthetic Telemetry",
  "description": "Contract for lab-only synthetic telemetry. This schema does not certify physical meter data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "device_id",
    "sequence",
    "timestamp",
    "uptime_ms",
    "pulse_count_total",
    "input_mode"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "device_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "uptime_ms": {
      "type": "integer",
      "minimum": 0
    },
    "pulse_count_total": {
      "type": "integer",
      "minimum": 1
    },
    "input_mode": {
      "type": "string",
      "const": "simulated"
    }
  }
}
